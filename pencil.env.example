# Copy to pencil.env and fill in. Run with: node --env-file=pencil.env server.js

# Your app as the phone/iPad sees it (Tailscale Serve URL, no trailing slash)
APP_ORIGIN=https://your-mac.your-tailnet.ts.net

# How the phone/iPad reaches Pencil Agent (Tailscale Serve URL on port 8443)
PUBLIC_URL=https://your-mac.your-tailnet.ts.net:8443

# The repo Claude is allowed to edit
PROJECT_DIR=/Users/you/code/your-app

# Optional
# CLAUDE_MODEL=sonnet
# PORT=4545
# WHISPER_MODEL=/Users/you/models/ggml-base.en.bin
